{
  "name": "api",
  "version": "1.0.0",
  "description": "MobileLens REST API",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build":   "tsc",
    "dev":     "tsx watch src/index.ts",
    "start":   "node dist/index.js",
    "migrate": "drizzle-kit migrate",
    "generate":"drizzle-kit generate"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "better-auth": "^1.6.27",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "minio": "^8.0.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
